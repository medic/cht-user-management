{% assign is_multiple = prop.type == 'select_multiple' %}
{% assign selected_values = data[prop_name] | join: ' ' | split: ' ' %}
<div class="select is-fullwidth{% if is_multiple %} is-multiple{% endif %}">
  <select
    name="{{ prop_name }}"
    {% if is_multiple %}
      multiple
    {% endif %}
  >
    {% for params in prop.parameter %}
      <option
        value="{{ params[0] }}"
        {% if is_multiple %}
          {% if selected_values contains params[0] %}
            selected
          {% endif %}
        {% elsif data[prop_name] == params[0] %}
          selected
        {% endif %}
      >
        {{ params[1] }}
      </option>
    {% endfor %}
  </select>
</div>
