# The server refuses to start if any required setting is missing or invalid.

# Required. Encrypt session tokens and background-job tokens; at least 32 characters, and different
# from each other. Rotating COOKIE_PRIVATE_KEY signs everyone out.
COOKIE_PRIVATE_KEY=
WORKER_PRIVATE_KEY=
# Required. 64 hex characters: encrypts staged items and credentials. eg. `openssl rand -hex 32`
SECRET_KEY=
# Required. The only datastore (see APP.md → Data storage). Use rediss:// for TLS.
REDIS_URL=redis://localhost:6379

# Required. The deployment's folder: config.json (its contact types), instances.json (the CHT instances
# users sign in to), optionally a logo (logo.png, .jpg, .svg or .webp), and the hook scripts its
# contact types list. Any folder in that shape works, eg. one of config/deployments/, or one mounted
# into the container
DEPLOYMENT_DIR=config/deployments/chis-ke
# Outside production only: also offer a local CHT
#CHT_DEV_INSTANCE=localhost:5988
#CHT_DEV_HTTP=true         # only for a plain-http CHT; the dev instance uses https otherwise
#CHT_DEV_IDP_ORIGINS=http://localhost:8080

# How long a sign-in lasts, in seconds. Keep it no longer than the instance's CouchDB session timeout.
#SESSION_TTL=86400
# false refuses CHT admins
#ALLOW_ADMIN_LOGIN=true
# How long the app holds what succeeded, in seconds: done staged items, finished jobs with their logs
# and archives, and generated passwords. The only data lifetime: anything unfinished or failed is kept
# until it's dealt with
#DATA_RETENTION_TTL=1209600

#BATCH_MAX_ITEMS=100
# A place type with more places than this, eg. households, is never read whole: it's only searched
# and looked up under one parent at a time (see APP.md → Finding places)
#MAX_PLACES_LOADED=10000

# Hierarchy jobs (moving, merging and deleting places; see APP.md → Running the job)
# Postpone a job while CHT's Sentinel has more changes than this waiting, and check again after JOB_RECHECK seconds
#MAX_SENTINEL_BACKLOG=7000
#JOB_RECHECK=900
# Where each job's cht-conf working folder goes (removed when the job ends), and cht-conf's limits
#JOB_WORK_DIR=/tmp/cht-iam-jobs
#JOB_TIMEOUT=14400
#CHT_CONF_HEAP_MB=2048
# Copies of every doc a delete or merge removes, kept as long as their job
#ARCHIVE_LOCATION=data/archives
#PORT=3000
