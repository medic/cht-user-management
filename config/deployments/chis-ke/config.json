          "type": "regex",
          "parameter": "^\\d{5}$",
          "errorDescription": "Expects a five digit number (eg. 12345)",
          "required": true
        }
      ],
      "contact_properties": [
        {
          "friendly_name": "CHA Name",
          "property_name": "name",
          "type": "name",
          "parameter": ["\\(\\s*PHO\\s*\\)", "\\(\\s*CHA\\s*\\)"],
          "required": true
        },
        {
          "friendly_name": "CHA Phone",
          "property_name": "phone",
          "type": "phone",
          "parameter": "KE",
          "required": true
        },
        {
          "friendly_name": "Require password change",
          "property_name": "require_password_change",
          "type": "select_one",
          "required": false,
          "parameter": {
            "yes": "Yes",
            "no": "No"
          }
        }
      ]
    },
